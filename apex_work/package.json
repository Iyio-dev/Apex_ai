{
  "name": "apex-server",
  "version": "1.0.0",
  "private": true,
  "description": "APEX JUPEB learning dashboard API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/routes/academicRoutes.js && node --check src/services/academicService.js && node --check src/services/aiService.js",
