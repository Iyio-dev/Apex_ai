    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "type": "module"
}
