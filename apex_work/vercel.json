{
  "installCommand": "npm ci --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://apex-k15z.onrender.com/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://apex-k15z.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://apex-k15z.onrender.com/ready"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
